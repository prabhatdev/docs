{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Dume.ai- AI Executive assistant",
  "colors": {
    "primary": "#16A34A",
    "light": "#07C983",
    "dark": "#15803D"
  },
  "icons": {
    "library": "fontawesome"
  },
  "seo": {
    "indexing": "all",
    "metatags": {
      "og:image": "/images/default_meta_tag.png"
    }
  },
  "redirects": [
    {
      "source": "/Github",
      "destination": "/github"
    },
    {
      "source": "/Calender",
      "destination": "/calendar"
    },
    {
      "source": "/calender",
      "destination": "/calendar"
    },
    {
      "source": "/deepresearch",
      "destination": "/"
    }
  ],
  "favicon": "/favicon.svg",
  "navigation": {
    "groups": [
      {
        "group": "Get Started",
